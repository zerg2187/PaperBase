# PostgreSQL / Supabase
# Supabase の場合: Project Settings → Database → Connection string → URI
DATABASE_URL=postgres://postgres:password@localhost:5432/paperbase?sslmode=disable

# Google Gemini API
# https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key

# Semantic Scholar API
# https://www.semanticscholar.org/product/api
SEMANTIC_API_KEY=your_semantic_scholar_api_key

# 管理者認証
# 任意の強力な文字列を設定
ADMIN_SECRET_TOKEN=your_admin_secret_token

# フロントエンド URL（CORS 許可用）
FRONTEND_URL=http://localhost:5173

# バックエンドポート（任意）
PORT=8080

# フロントエンド（開発時）
VITE_API_BASE_URL=http://localhost:8080
